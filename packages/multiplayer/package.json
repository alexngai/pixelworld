{
  "name": "@pixelworlds/multiplayer",
  "version": "0.0.0",
  "private": true,
  "description": "Multiplayer for pixelworld games: a WebSocket relay with rooms, a room client, and other players drawn as smoothed entities",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexngai/pixelworld.git",
    "directory": "packages/multiplayer"
  },
  "homepage": "https://github.com/alexngai/pixelworld/blob/main/packages/multiplayer/README.md",
  "bugs": "https://github.com/alexngai/pixelworld/issues",
  "keywords": [
    "pixelworld",
    "multiplayer",
    "websocket",
    "relay",
    "netcode",
    "interpolation"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "demo:dogfight": "vite --config src/demos/dogfight/vite.config.ts",
    "demo:dogfight:build": "vite build --config src/demos/dogfight/vite.config.ts && vite build --config src/demos/dogfight/vite.config.ts --ssr serve.ts",
    "demo:dogfight:start": "node src/demos/dogfight/dist/server/serve.js"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "peerDependencies": {
    "pixelworld": "workspace:^"
  },
  "devDependencies": {
    "@pixelworlds/game": "workspace:*",
    "@types/ws": "8.18.1",
    "pixelworld": "workspace:*",
    "tsup": "9.0.0"
  }
}
